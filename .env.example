# API credentials for the booktense study (narrative tense in fiction over time)
# Created 2026-08-03. Do not commit.

# NYT Developer — Books API (bestseller lists, back to 1931)
# Docs: https://developer.nytimes.com/docs/books-product/1/overview
# Usage: append ?api-key=
NYT_BOOKS_API_KEY=

# Google Books API v1 (metadata, viewability). Free tier 1000 req/day.
# Docs: https://developers.google.com/books/docs/v1/using
# Usage: append &key=
GOOGLE_BOOKS_API_KEY=
